{
  "name": "waterscout",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "dev:web": "corepack pnpm --filter @waterscout/web dev",
    "dev:mobile": "corepack pnpm --filter @waterscout/mobile start",
    "dev:api": "corepack pnpm --filter @waterscout/server dev",
    "typecheck": "corepack pnpm --filter @waterscout/core typecheck && corepack pnpm --filter @waterscout/server typecheck && corepack pnpm --filter @waterscout/web typecheck && corepack pnpm --filter @waterscout/mobile typecheck",
    "test": "vitest run",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "db:start": "supabase start --exclude gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "build:web": "corepack pnpm --filter @waterscout/web build",
    "build:mobile:android": "corepack pnpm --filter @waterscout/mobile android"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
